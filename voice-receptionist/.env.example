# ============================================
# APPLICATION SETTINGS
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_NAME="Voice Receptionist"
APP_SECRET_KEY=change-this-to-a-secure-random-string-minimum-32-chars

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_receptionist
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis for caching and sessions
REDIS_URL=redis://localhost:6379/0

# ============================================
# VOICE AI SERVICES (Self-Hosted)
# ============================================
# Speech-to-Text (Whisper)
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
# Options: tiny, base, small, medium, large-v3
# Device: cpu, cuda

# Large Language Model (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct
# Other options: llama3.1:8b, mixtral:8x7b

# Text-to-Speech (Piper)
PIPER_VOICE=en_US-lessac-medium
PIPER_SPEED=1.0

# ============================================
# TELEPHONY (Choose One Setup)
# ============================================
# Option 1: Asterisk (Self-Hosted)
ASTERISK_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=voice_ai
ASTERISK_AMI_SECRET=your_ami_secret

# Option 2: Twilio (Cloud)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SIP Trunk (for Asterisk)
SIP_TRUNK_HOST=
SIP_TRUNK_USER=
SIP_TRUNK_PASS=

# ============================================
# NOTIFICATIONS
# ============================================
# SMS via Twilio
SMS_ENABLED=true
SMS_PROVIDER=twilio

# Email via SMTP
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# WhatsApp (optional)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ============================================
# SECURITY
# ============================================
JWT_SECRET_KEY=jwt-secret-key-change-this-minimum-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
# Options: json, text

# ============================================
# BUSINESS DEFAULTS
# ============================================
DEFAULT_TIMEZONE=UTC
DEFAULT_LANGUAGE=en
CALL_RECORDING_ENABLED=true
RECORDING_RETENTION_DAYS=30
