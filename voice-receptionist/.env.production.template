# Production Environment Configuration
# Copy this file to .env.production and fill in real values

# ===========================================
# APPLICATION
# ===========================================
APP_ENV=production
APP_NAME="Voice Receptionist"
DEBUG=false

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://user:password@db-host:5432/voice_receptionist
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===========================================
# REDIS (for caching and sessions)
# ===========================================
REDIS_URL=redis://redis-host:6379/0

# ===========================================
# SECURITY
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# TWILIO (Voice Pipeline)
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ===========================================
# DEEPGRAM (Speech-to-Text)
# ===========================================
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2

# ===========================================
# CARTESIA (Text-to-Speech)
# ===========================================
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=optional_voice_id

# ===========================================
# OLLAMA (LLM) - or use external API
# ===========================================
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral:7b-instruct

# ===========================================
# EMAIL (SMTP)
# ===========================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@yourdomain.com

# ===========================================
# SMS (Twilio)
# ===========================================
SMS_ENABLED=true
SMS_PROVIDER=twilio

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
