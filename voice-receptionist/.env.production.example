# Production Environment Variables
# Copy to .env.production and fill in values

# ===================
# APP SETTINGS
# ===================
APP_ENV=production
APP_DEBUG=false
APP_NAME="Voice Receptionist"

# ===================
# SECURITY (REQUIRED)
# ===================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
APP_SECRET_KEY=

# ===================
# DATABASE (REQUIRED)
# ===================
POSTGRES_USER=voice_admin
POSTGRES_PASSWORD=
POSTGRES_DB=voice_receptionist

# ===================
# REDIS
# ===================
REDIS_PASSWORD=

# ===================
# TWILIO (For SMS/Voice)
# ===================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===================
# EMAIL (SMTP)
# ===================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# ===================
# VOICE AI (Self-hosted)
# ===================
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
PIPER_VOICE=en_US-lessac-medium
PIPER_SPEED=1.0

# ===================
# CALENDAR SYNC (Optional)
# ===================
# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_ID=

# Outlook/Office 365
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=

# ===================
# MONITORING (Optional)
# ===================
SENTRY_DSN=
